{
  "manifest_version": 3,
  "name": "Superstation IPTV – Direct Streams",
  "version": "1.0.0",
  "description": "Lets your self-hosted Superstation IPTV play streams straight from the provider, even when the provider doesn't allow web players.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js", "scripts": ["bg.js"] },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["cs.js"], "run_at": "document_end" }],
  "icons": { "128": "icon.png" },
  "browser_specific_settings": { "gecko": { "id": "direct-streams@browser-iptv-player", "strict_min_version": "128.0" } }
}
