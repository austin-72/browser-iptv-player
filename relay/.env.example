# The relay machine's name on the internet (it must point at this machine): your own domain, or a free one from
# duckdns.org such as myrelay.duckdns.org
RELAY_DOMAIN=relay.example.com
# The secret from Admin → Network & proxies → Stream relay → Copy the secret
RELAY_SECRET=
# Optional: also be the proxy for your home server's own traffic (lists, guides, TMDB, conversions).
# Set all three, open port 8888, and add http://USER:PASSWORD@RELAY_DOMAIN:8888 in Admin → Network & proxies → Proxies.
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
# Optional: the most disk space whole films may take (default: all the free space but 5 GB).
RELAY_CACHE_GB=

# ---- Optional: the relay through a VPN (start it with:  docker compose -f docker-compose.vpn.yml up -d)
# Providers then see the VPN's address, not this machine's. These are gluetun's settings: the names for your VPN
# service are at https://github.com/qdm12/gluetun-wiki (setup → providers). For example, Mullvad with WireGuard:
#   VPN_SERVICE_PROVIDER=mullvad
#   VPN_TYPE=wireguard
#   WIREGUARD_PRIVATE_KEY=<from your VPN account's WireGuard configuration>
#   WIREGUARD_ADDRESSES=10.64.222.21/32
#   SERVER_CITIES=Amsterdam
# Any other service with a WireGuard file: VPN_SERVICE_PROVIDER=custom, VPN_TYPE=wireguard, and the values from the file
# (WIREGUARD_PRIVATE_KEY, WIREGUARD_ADDRESSES, WIREGUARD_PUBLIC_KEY, WIREGUARD_ENDPOINT_IP, WIREGUARD_ENDPOINT_PORT).
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=
