# The relay machine's name on the internet (it must point at this machine): your own domain, or a free one from
# duckdns.org such as myrelay.duckdns.org
RELAY_DOMAIN=relay.example.com
# The secret from Admin → Network & proxies → Stream relay → Copy the secret
RELAY_SECRET=
# Optional: also be the proxy for your home server's own traffic (lists, guides, TMDB, conversions).
# Set all three, open port 8888, and add http://USER:PASSWORD@RELAY_DOMAIN:8888 in Admin → Network & proxies → Proxies.
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
# Optional: the most disk space whole films may take (default: all the free space but 5 GB).
RELAY_CACHE_GB=
