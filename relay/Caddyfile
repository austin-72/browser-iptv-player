# https for the stream relay: Caddy gets a free certificate for RELAY_DOMAIN by itself (ports 80 and 443 must be open).
{$RELAY_DOMAIN} {
	# (Through a VPN — docker-compose.vpn.yml — the relay lives inside the VPN's container: RELAY_UPSTREAM=gluetun:8090.)
	reverse_proxy {$RELAY_UPSTREAM:relay:8090} {
		flush_interval -1
	}
}
